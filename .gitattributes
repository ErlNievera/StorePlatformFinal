# Normalize line endings in the repository.
* text=auto

# Windows scripts must keep CRLF so cmd.exe parses them correctly.
*.cmd text eol=crlf
*.bat text eol=crlf

# Unix shell scripts and container files must keep LF.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
