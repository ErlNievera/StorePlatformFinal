@model AdminProductsViewModel
@{
    ViewData["Title"] = "Products";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0"><i class="bi bi-tags" aria-hidden="true"></i> Products</h1>
    <button type="button" class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#createProduct"><i class="bi bi-plus-lg" aria-hidden="true"></i> New product</button>
</div>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-warning" role="status">@Model.Error</div>
}
@if (Model.Products.Count == 0 && string.IsNullOrEmpty(Model.Error))
{
    <section class="empty-state ac-card"><div class="icon"><i class="bi bi-tags" aria-hidden="true"></i></div><h2 class="h4">No products yet</h2><p class="text-muted">Create the first one with “New product”.</p></section>
}
else if (Model.Products.Count > 0)
{
    <div class="ac-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">All products, including hidden ones</caption>
                <thead><tr><th scope="col" class="ps-3">Name</th><th scope="col" class="text-end">Price</th><th scope="col">Status</th><th scope="col">Updated</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr>
                            <td class="ps-3"><a href="/products/@p.ProductId">@p.Name</a><div class="small text-muted text-truncate" style="max-width: 28rem">@p.Description</div></td>
                            <td class="text-end">@Money.Format(p.Price, p.Currency)</td>
                            <td>@if (p.IsActive) { <span class="badge badge-stock">Active</span> } else { <span class="badge badge-inactive">Hidden</span> }</td>
                            <td class="small"><time datetime="@p.UpdatedAt.ToString("O")">@p.UpdatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</time></td>
                            <td class="text-end pe-3"><a class="btn btn-sm btn-outline-primary" href="/admin/products/@p.ProductId/edit"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="modal fade" id="createProduct" tabindex="-1" aria-labelledby="createProductTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" asp-antiforgery="true" action="/admin/products">
            <div class="modal-header">
                <h2 class="modal-title h5" id="createProductTitle">New product</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label asp-for="NewProduct.Name" class="form-label">Name</label>
                    <input asp-for="NewProduct.Name" class="form-control" required minlength="2" maxlength="120" />
                </div>
                <div class="mb-3">
                    <label asp-for="NewProduct.Description" class="form-label">Description</label>
                    <textarea asp-for="NewProduct.Description" class="form-control" rows="3" maxlength="1000"></textarea>
                </div>
                <div class="row g-2">
                    <div class="col-7">
                        <label asp-for="NewProduct.Price" class="form-label">Price</label>
                        <input asp-for="NewProduct.Price" class="form-control" type="number" step="0.01" min="0.01" required value="" />
                    </div>
                    <div class="col-5">
                        <label asp-for="NewProduct.Currency" class="form-label">Currency</label>
                        <input asp-for="NewProduct.Currency" class="form-control" maxlength="3" required />
                    </div>
                </div>
                <div class="form-check form-switch mt-3">
                    <input asp-for="NewProduct.IsActive" class="form-check-input" role="switch" />
                    <label asp-for="NewProduct.IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Create product</button>
            </div>
        </form>
    </div>
</div>
