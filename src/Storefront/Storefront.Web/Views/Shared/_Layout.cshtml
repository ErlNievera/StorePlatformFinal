@inject CartService Cart
@{
    var title = ViewData["Title"] as string;
    var isAdmin = User.IsInRole("Admin");
    var isCustomer = User.IsInRole("Customer");
    var path = Context.Request.Path.Value ?? "/";
    string Active(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    var itemCount = Cart.ItemCount;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@(string.IsNullOrEmpty(title) ? "UST Angelicum College Store" : $"{title} · UST Angelicum College Store")</title>
    <script>
        (function () {
            var theme = null;
            try { theme = localStorage.getItem("ac-theme"); } catch (e) { }
            if (theme !== "dark" && theme !== "light") {
                theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.setAttribute("data-bs-theme", theme);
        })();
    </script>
    <link rel="icon" href="~/images/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div id="splash" class="splash" aria-hidden="true">
        <div class="splash-inner">
            <div class="splash-ring">
                <img src="~/images/logo.png" alt="" onerror="this.replaceWith(document.createTextNode('AC'))" />
            </div>
            <div class="display-font fs-4">UST Angelicum College</div>
            <div class="small text-uppercase" style="letter-spacing:.2em">Caritas · Justitia · Fortitudo</div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg ac-navbar sticky-top" aria-label="Main">
            <div class="container">
                <a class="brand navbar-brand" href="/">
                    <img class="brand-logo" src="~/images/logo.png" alt="UST Angelicum College logo"
                         onerror="this.hidden = true; this.nextElementSibling.hidden = false;" />
                    <span class="brand-monogram" hidden aria-hidden="true">AC</span>
                    <span>UST Angelicum College<small>Campus Store</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link @(path == "/" || path.StartsWith("/products") ? "active" : "")" href="/"><i class="bi bi-shop" aria-hidden="true"></i> Shop</a></li>
                        @if (isCustomer)
                        {
                            <li class="nav-item"><a class="nav-link @Active("/orders")" href="/orders"><i class="bi bi-bag-check" aria-hidden="true"></i> My Orders</a></li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @Active("/admin")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock" aria-hidden="true"></i> Admin
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/admin/products"><i class="bi bi-tags" aria-hidden="true"></i> Products</a></li>
                                    <li><a class="dropdown-item" href="/admin/stock"><i class="bi bi-boxes" aria-hidden="true"></i> Stock</a></li>
                                    <li><a class="dropdown-item" href="/admin/chaos"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Chaos &amp; Saga Testing</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-sm btn-light position-relative" href="/cart" aria-label="Cart, @itemCount item(s)">
                            <i class="bi bi-cart3" aria-hidden="true"></i> Cart
                            @if (itemCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill cart-badge">@itemCount</span>
                            }
                        </a>
                        <button id="themeToggle" type="button" class="btn btn-sm theme-toggle" aria-pressed="false" aria-label="Switch to dark mode">
                            <i class="bi bi-moon-stars" aria-hidden="true"></i>
                        </button>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle" aria-hidden="true"></i> @User.Identity!.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item-text small text-muted">Signed in as @(isAdmin ? "Admin" : "Customer")</span></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" action="/account/logout">
                                            <button type="submit" class="dropdown-item no-spinner"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-gold" href="/account/login">Sign in</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div id="toastStack" class="toast-stack" aria-live="polite">
        <partial name="_Toast" />
    </div>

    <main id="main" class="container py-4 page-enter" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="ac-footer mt-5">
        <div class="container py-4 d-flex flex-column flex-md-row justify-content-between gap-2">
            <div class="display-font">&copy; 2026 UST Angelicum College &bull; Caritas &bull; Justitia &bull; Fortitudo</div>
            <div class="small">Campus Store &middot; Orders are processed through the Store Platform gateway</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
