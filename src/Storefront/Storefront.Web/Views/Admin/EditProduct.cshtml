@model ProductFormViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="ac-card p-4 p-md-5">
            <a href="/admin/products" class="small"><i class="bi bi-arrow-left" aria-hidden="true"></i> All products</a>
            <h1 class="h2 mt-2">Edit product</h1>
            <div class="gold-rule my-3"></div>
            <form method="post" asp-antiforgery="true" action="/admin/products/@Model.ProductId/edit" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-5">
                        <label asp-for="Currency" class="form-label"></label>
                        <input asp-for="Currency" class="form-control" maxlength="3" />
                        <span asp-validation-for="Currency" class="text-danger small"></span>
                    </div>
                </div>
                <div class="form-check form-switch mb-4">
                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a class="btn btn-outline-primary" href="/admin/products">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
