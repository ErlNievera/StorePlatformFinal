# =====================================================================
# Store Platform — LOCAL DEVELOPMENT VALUES ONLY
# =====================================================================
# setup.cmd copies this file to .env (which is gitignored).
# Every value here is a throw-away default for a laptop demo.
# Never reuse these passwords or the signing key anywhere real.
# =====================================================================

# ---------- ASP.NET Core ----------
ASPNETCORE_ENVIRONMENT=Development

# ---------- Host ports (container ports are fixed in docker-compose.yml) ----------
GATEWAY_PORT=5000
IDENTITY_PORT=5001
CATALOG_PORT=5002
INVENTORY_PORT=5003
ORDER_PORT=5004
PAYMENT_PORT=5005
STOREFRONT_PORT=5100
RABBITMQ_UI_PORT=15672

# ---------- PostgreSQL 16 (one container per service, not exposed to the host) ----------
POSTGRES_USER=store
POSTGRES_PASSWORD=store_local_dev_pw
IDENTITY_DB=identity_db
CATALOG_DB=catalog_db
INVENTORY_DB=inventory_db
ORDER_DB=order_db
PAYMENT_DB=payment_db

# ---------- RabbitMQ (guest/guest is the image default, allowed for local dev) ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=store.events
RABBITMQ_DLX=store.dlx
RABBITMQ_MAX_DELIVERY_ATTEMPTS=3

# ---------- JWT (issued by Identity, validated by Gateway and every service) ----------
JWT_ISSUER=store-identity
JWT_AUDIENCE=store-platform
JWT_SIGNING_KEY=local-dev-only-signing-key-0123456789-abcdefghijklmnop
JWT_EXPIRES_MINUTES=60

# ---------- Seeded demo accounts (created by Identity at startup) ----------
SEED_ADMIN_EMAIL=admin@store.local
SEED_ADMIN_PASSWORD=Admin#Dev2026
SEED_CUSTOMER_EMAIL=customer@store.local
SEED_CUSTOMER_PASSWORD=Customer#Dev2026
